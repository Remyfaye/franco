[00:41:18.913] Browser LOG     categories report {"data":[{"createdAt":"2025-12-05T07:46:02.738Z","id":"38a64c65-23ed-4af2-a9ce-88e2ba9c1fe9","name":"Smart Gadgets","products":[{"categoryId":"38a64c65-23ed-4af2-a9ce-88e2ba9c1fe9","createdAt":"2025-12-05T07:55:01.157Z","description":"Poly Savi 8445 delivers flexible comfort, continuous talk time, wide-reaching DECT coverage, and seamless multi-device integration—all built for hybrid professionals who demand versatility and performance.","discountPercentage":20,"id":"7a9b888b-5ee9-4ac9-a057-0bf4c55d3286","imageUrls":"[Array]","isActive":true,"label":null,"name":"Poly   Savi   8445   Office   Wireless   Dect   Headset","oldPrice":125000,"price":100000,"stock":39,"updatedAt":"2025-12-05T07:55:01.157Z"},{"categoryId":"38a64c65-23ed-4af2-a9ce-88e2ba9c1fe9","createdAt":"2025-12-05T08:02:43.550Z","description":"Steerable Two‑Mic Array – Microphone pickup up to 5 ft (1.5 m), focusing on voice while minimizing background noise.\r\nFull‑Duplex Audio – Enables natural, two-way conversations without interruptions.\r\n50 mm Speaker + Dual Passive Radiators – Delivers high-fidelity sound suitable for both speech and entertainment.\r\nTouch Controls & LED Status Bar – Intuitive interface for calls, volume, mute, and status visibility.\r\nUSB-A with USB-C Adapter – Plug-and-play connectivity across PCs and Macs; no external power needed.\r\nIP64 Dust & Water Resistant – Durable build for use in varied environments.\r\nPlatform Certified – Works seamlessly with Zoom, Microsoft Teams (Teams version includes dedicated Teams button), and more.\r\nSmart Management via Poly Lens – Easily manage settings, firmware, and device insights remotely.","discountPercentage":null,"id":"6d6d24ed-5a77-4300-ad4d-4f3d7f1f858f","imageUrls":"[Array]","isActive":true,"label":null,"name":"Poly   Sync   10   Professional   USB   Conference   Speaker","oldPrice":50000,"price":43999,"stock":199,"updatedAt":"2025-12-05T08:02:43.550Z"},{"categoryId":"38a64c65-23ed-4af2-a9ce-88e2ba9c1fe9","createdAt":"2025-12-05T08:11:17.063Z","description":"Touchscreen Charge Case – Control calls, mute, ANC, and pairing directly from the smart case.\r\nSeamless PC & Mobile Connectivity – Connect to PCs (via BT700 adapter), smartphones, and tablets effortlessly.\r\nQi Wireless Charging – Convenient wireless charging support for the case.\r\nBT700 USB Bluetooth Adapter – Enables long-range (up to 98 ft) stable connections to laptops and desktops.\r\nSix-Microphone Array + WindSmart – Enhanced call clarity with advanced noise suppression.\r\nAdaptive Hybrid ANC – Blocks distractions with adjustable noise cancellation modes.\r\nPoly NoiseBlockAI – Reduces background noise intelligently for professional calls.\r\nMultipoint Pairing – Connect and switch between multiple devices (PC, Android, iPhone).\r\nLong Battery Life – Up to 5.5 hrs of use per charge, with 16 hrs additional playback from the case.\r\nUC Platform Certified – Optimized for Teams, Zoom, Google Meet, and more.","discountPercentage":null,"id":"ca245792-5cf3-4c71-b229-73b68a4222b8","imageUrls":"[Array]","isActive":true,"label":null,"name":"Poly   Voyager   Free   60   UC   -   Touchscreen   True   Wireless   Earbuds","oldPrice":null,"price":33999,"stock":20,"updatedAt":"2025-12-06T05:47:29.336Z"}],"updatedAt":"2025-12-05T07:46:02.738Z"},{"createdAt":"2025-12-05T06:43:22.691Z","id":"122ee78d-1aba-4c4f-8e52-00357c23a1c9","name":"Phones","products":[{"categoryId":"122ee78d-1aba-4c4f-8e52-00357c23a1c9","createdAt":"2025-12-05T07:15:57.682Z","description":"In stock! Ships within 1-2 business days.","discountPercentage":null,"id":"571d3911-35ec-49fc-b247-88f123b51913","imageUrls":"[Array]","isActive":true,"label":null,"name":"128GB   Apple   iPhone   12   Pro   Max","oldPrice":709000,"price":650000,"stock":22,"updatedAt":"2025-12-05T07:15:57.682Z"},{"categoryId":"122ee78d-1aba-4c4f-8e52-00357c23a1c9","createdAt":"2025-12-05T07:18:21.854Z","description":"In stock! Ships within 1-2 busin